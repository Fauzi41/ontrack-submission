{
  "name": "ontrack",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "npm -w backend run dev",
    "dev:web": "npm -w frontend run dev",
    "import": "npm -w backend run import",
    "test": "npm -w backend run test",
    "build": "npm -w frontend run build"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "esbuild@0.21.5": true,
    "better-sqlite3@11.10.0": true
  }
}
